{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:next": {
      "dependsOn": ["build:registry", "build:docs"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build:docs": {
      "dependsOn": ["build:registry"],
      "outputs": [".velite/**"]
    },
    "build:registry": {
      "outputs": ["public/r/**"]
    },
    "dev:next": {
      "cache": false,
      "persistent": true
    },
    "dev:docs": {
      "cache": false,
      "persistent": true
    }
  }
}
